PORT=8787

# 화면. `pnpm start`가 프로토타입을 PROTOTYPE_PORT에 띄우고 이 값을 자동으로
# 채우므로 보통 비워 둔다. 이미 다른 곳에 떠 있는 화면을 쓸 때만 지정한다.
# SKIP_PROTOTYPE=1이면 화면을 띄우지 않고 화면 경로는 404가 된다.
PROTOTYPE_PORT=3100
PROTOTYPE_ORIGIN=
SKIP_PROTOTYPE=
HTTP_HOST=127.0.0.1
HTTP_AUTH_MODE=off
HTTP_AUTH_TOKEN=
HTTP_TRUST_PROXY=off
HTTP_TRUST_PROXY_IPS=
HTTP_BODY_MAX_BYTES=65536
HTTP_JSON_MAX_DEPTH=12
HTTP_JSON_MAX_NODES=5000
HTTP_JSON_MAX_ARRAY_ITEMS=1000
HTTP_RATE_LIMIT_CHEAP_PER_MINUTE=120
HTTP_RATE_LIMIT_EXPENSIVE_PER_MINUTE=12
HTTP_RATE_LIMIT_READY_PER_MINUTE=60
HTTP_RATE_LIMIT_MAX_BUCKETS=10000
HTTP_RATE_LIMIT_IDLE_MS=600000
# Optional: shares rate-limit state across multiple mcp-server instances
# behind a load balancer via Redis. Leave unset for single-instance
# deployments (falls back to the in-process limiter, unchanged behaviour).
REDIS_URL=
# /api/agent는 플래너 LLM 호출을 포함하므로 12초 기본값으로는 모자란다.
# gpt-5.6-sol 같은 추론 모델은 도구 선택에만 수십 초를 쓴다.
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_CHEAP_OPERATION_TIMEOUT_MS=8000
HTTP_EXPENSIVE_OPERATION_TIMEOUT_MS=90000
DATA_REPOSITORY=auto
# 도구를 고르는 플래너 모델. 비우면 설정된 API 키 순서로 고른다.
PLANNER_MODEL=gpt-5.6-sol
# 프로토타입 웹에서 근거를 카드로 배치하는 모델
PROTOTYPE_MODEL=claude-sonnet-5
LOG_LEVEL=info
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=8000
PG_QUERY_TIMEOUT_MS=10000
AUDIT_HASH_SALT=replace-with-deployment-secret
LIFECYCLE_MIN_RETENTION_DAYS=30
STORAGE_WARN_STALE_RATIO_PERCENT=25
STORAGE_WARN_DATABASE_BYTES=2147483648
STORAGE_WARN_EMBEDDING_ROWS=250000
STORAGE_WARN_EXPIRED_AUDIT_ROWS=10000
DATABASE_URL=postgresql://gyeongbuk:gyeongbuk@localhost:5432/gyeongbuk