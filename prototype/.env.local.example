# 도구 호출은 MCP 프로토콜로 이 주소에 직접 붙는다. /api/agent 프롬프트 플래너를
# 거치지 않으므로, 도구 목록과 결과가 모델에게 그대로 전달된다.
MCP_SERVER_URL=https://use.me.kr/mcp
# 추천 질문 목록(/api/questions)을 가져올 MCP 서버 HTTP 주소
MCP_BASE_URL=http://127.0.0.1:8790
# MCP 서버가 토큰 인증 모드일 때만 필요하다
MCP_AUTH_TOKEN=
# 답변을 화면 카드로 구성하는 기본 모델
PROTOTYPE_MODEL=claude-sonnet-5
# 저장소 루트 .env의 CLAUDE_API_KEY를 그대로 사용한다
CLAUDE_API_KEY=
# 도구를 고르고 MCP를 호출하는 모델
PLANNER_MODEL=gpt-5.6-sol
# 저장소 루트 .env의 OPENAI_API_KEY를 그대로 사용한다
OPENAI_API_KEY=
