{
  "name": "gyeongbuk-public-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm -r --sort --if-present run typecheck",
    "lint": "pnpm -r --sort --if-present run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "etl": "pnpm --filter @gb/pipelines etl",
    "etl:dry-run": "pnpm --filter @gb/pipelines etl:dry-run",
    "dev": "pnpm --filter @gb/mcp-server dev:http",
    "start": "pnpm --filter @gb/mcp-server start:http"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

