{
  "name": "gyeongbuk-public-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm -r --sort --if-present run typecheck",
    "lint": "pnpm -r --sort --if-present run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "etl": "pnpm --filter @gb/pipelines etl",
    "etl:dry-run": "pnpm --filter @gb/pipelines etl:dry-run",
    "db:schema": "pnpm --filter @gb/pipelines db:schema",
    "db:load": "pnpm --filter @gb/pipelines db:load",
    "db:normalize": "pnpm --filter @gb/pipelines db:normalize",
    "pdf:normalize": "pnpm --filter @gb/pipelines pdf:normalize",
    "pdf:evaluate": "pnpm --filter @gb/pipelines pdf:evaluate",
    "pohang:crawl": "pnpm --filter @gb/pipelines pohang:crawl",
    "intake": "pnpm --filter @gb/pipelines intake",
    "intake:dry-run": "pnpm --filter @gb/pipelines intake:dry-run",
    "intake:status": "pnpm --filter @gb/pipelines intake:status",
    "experiment:intake-onboarding": "pnpm --filter @gb/pipelines intake:onboarding",
    "experiment:intake-reliability": "pnpm --filter @gb/pipelines intake:reliability",
    "lifecycle:status": "pnpm --filter @gb/pipelines lifecycle:status",
    "lifecycle:approve": "pnpm --filter @gb/pipelines lifecycle:approve",
    "lifecycle:retire": "pnpm --filter @gb/pipelines lifecycle:retire",
    "lifecycle:purge": "pnpm --filter @gb/pipelines lifecycle:purge",
    "lifecycle:audit-purge": "pnpm --filter @gb/pipelines lifecycle:audit-purge",
    "lifecycle:maintain": "pnpm --filter @gb/pipelines lifecycle:maintain",
    "dev": "node scripts/serve.mjs dev",
    "dev:server": "pnpm --filter @gb/mcp-server dev:http",
    "prototype:dev": "pnpm --filter @gb/prototype dev",
    "prototype:build": "pnpm --filter @gb/prototype build",
    "prototype:start": "pnpm --filter @gb/prototype start",
    "start": "node scripts/serve.mjs",
    "start:server": "pnpm --filter @gb/mcp-server start:http",
    "gb:press:crawl": "pnpm --filter @gb/pipelines gb:press:crawl",
    "gb:council:crawl": "pnpm --filter @gb/pipelines gb:council:crawl",
    "benchmark": "pnpm --filter @gb/mcp-server benchmark",
    "benchmark:compare": "pnpm --filter @gb/benchmark compare",
    "benchmark:raw-rag": "pnpm --filter @gb/benchmark compare:raw-rag",
    "benchmark:compare:dry-run": "pnpm --filter @gb/benchmark compare -- --dry-run",
    "benchmark:compare:models": "pnpm --filter @gb/benchmark compare:models"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
