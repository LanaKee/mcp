{
  "name": "@gb/pipelines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "etl": "tsx src/cli.ts --write",
    "etl:dry-run": "tsx src/cli.ts --dry-run",
    "db:schema": "tsx src/db-cli.ts schema",
    "db:load": "tsx src/db-cli.ts load",
    "db:normalize": "tsx src/db-cli.ts normalize",
    "pdf:normalize": "tsx src/pdf-cli.ts",
    "pdf:evaluate": "tsx src/pdf-evaluate.ts",
    "pohang:crawl": "tsx src/pohang-council-cli.ts",
    "intake": "tsx src/intake-cli.ts run",
    "intake:dry-run": "tsx src/intake-cli.ts run --dry-run",
    "intake:status": "tsx src/intake-cli.ts status",
    "intake:onboarding": "tsx src/intake-onboarding.ts",
    "intake:reliability": "tsx src/intake-reliability.ts",
    "lifecycle:status": "tsx src/lifecycle-cli.ts status",
    "lifecycle:approve": "tsx src/lifecycle-cli.ts approve",
    "lifecycle:retire": "tsx src/lifecycle-cli.ts retire",
    "lifecycle:purge": "tsx src/lifecycle-cli.ts purge",
    "lifecycle:audit-purge": "tsx src/lifecycle-cli.ts audit-purge",
    "lifecycle:maintain": "tsx src/lifecycle-cli.ts maintain",
    "gb:press:crawl": "tsx src/gb-press-release-cli.ts",
    "gb:council:crawl": "tsx src/gb-council-cli.ts"
  },
  "dependencies": {
    "@gb/retrieval": "workspace:*",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
